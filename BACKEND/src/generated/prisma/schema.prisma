// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Role {
  role_id   Int    @id @default(autoincrement())
  role_text String @unique
  users     User[]

  @@map("role")
}

model User {
  user_id   Int      @id @default(autoincrement())
  role_id   Int
  name      String
  email     String   @unique
  password  String
  join_date DateTime @default(now())

  role Role @relation(fields: [role_id], references: [role_id])

  classes     Class[]
  enrollments Enrollment[]
  exams       Exam[]
  reviews     Review[]

  recommendationRequests RecommendationRequest[]
  recommendationResults  RecommendationResult[]

  @@map("user")
}

model Category {
  category_id Int     @id @default(autoincrement())
  categories  String
  classes     Class[]

  recommendationRequests RecommendationRequest[]

  @@map("category")
}

model Periode {
  periode_id Int     @id @default(autoincrement())
  year       Int
  classes    Class[]

  recommendationRequests RecommendationRequest[]

  @@map("periode")
}

model Level {
  level_id   Int     @id @default(autoincrement())
  level_info String
  classes    Class[]

  @@map("level")
}

model Class {
  class_id Int @id @default(autoincrement())

  category_id Int
  periode_id  Int
  level_id    Int
  user_id     Int

  title       String
  description String @db.Text

  is_active Boolean  @default(true)
  mentor    User     @relation(fields: [user_id], references: [user_id])
  category  Category @relation(fields: [category_id], references: [category_id])
  periode   Periode  @relation(fields: [periode_id], references: [periode_id])
  level     Level    @relation(fields: [level_id], references: [level_id])

  materis    Materi[]
  exams      Exam[]
  reviews    Review[]
  enrollment Enrollment[]

  @@map("class")
}

model Enrollment {
  enrollment_id Int    @id @default(autoincrement())
  user_id       Int
  class_id      Int
  progress      Int    @default(0)
  role_in_class String

  user  User  @relation(fields: [user_id], references: [user_id])
  class Class @relation(fields: [class_id], references: [class_id])

  @@map("enrollment")
}

model Materi {
  materi_id Int @id @default(autoincrement())

  class_id Int

  title     String
  content   String @db.Text
  video_url String

  class Class @relation(fields: [class_id], references: [class_id])

  @@map("materi")
}

model Exam {
  exam_id   Int     @id @default(autoincrement())
  class_id  Int
  user_id   Int
  title     String
  min_score Int     @default(60)
  score     Int     @default(0)
  is_passed Boolean @default(false)

  class Class @relation(fields: [class_id], references: [class_id])
  user  User  @relation(fields: [user_id], references: [user_id])

  @@map("exam")
}

model Review {
  review_id Int @id @default(autoincrement())

  user_id  Int
  class_id Int

  rating  Int
  comment String @db.Text

  user  User  @relation(fields: [user_id], references: [user_id])
  class Class @relation(fields: [class_id], references: [class_id])

  @@map("review")
}

model Kriteria {
  id_kriteria Int    @id @default(autoincrement())
  kode        String @unique
  nama        String
  tipe        String // benefit / cost
  bobot       Float

  values KriteriaValue[]

  weights RequestBobot[]

  @@map("kriteria")
}

model KriteriaValue {
  id_value    Int    @id @default(autoincrement())
  id_kriteria Int
  value       String
  score       Float

  kriteria Kriteria @relation(fields: [id_kriteria], references: [id_kriteria])

  @@unique([id_kriteria, value])
  @@map("kriteria_value")
}

model RecommendationRequest {
  id_recomen  Int      @id @default(autoincrement())
  user_id     Int
  category_id Int
  periode_id  Int
  method      String // SAW / WP / TOPSIS
  created_at  DateTime @default(now())

  user     User                   @relation(fields: [user_id], references: [user_id])
  category Category               @relation(fields: [category_id], references: [category_id])
  periode  Periode                @relation(fields: [periode_id], references: [periode_id])
  weights  RequestBobot[]
  results  RecommendationResult[]

  @@map("recommendation_request")
}

model RequestBobot {
  id_bobot    Int   @id @default(autoincrement())
  id_recomen  Int
  id_kriteria Int
  bobot_req   Float

  request  RecommendationRequest @relation(fields: [id_recomen], references: [id_recomen])
  kriteria Kriteria              @relation(fields: [id_kriteria], references: [id_kriteria])

  @@map("request_bobot")
}

model RecommendationResult {
  id_hasil   Int   @id @default(autoincrement())
  id_recomen Int
  user_id    Int
  score      Float
  ranking    Int

  request RecommendationRequest @relation(fields: [id_recomen], references: [id_recomen])
  user    User                  @relation(fields: [user_id], references: [user_id])

  @@map("recommendation_result")
}
